<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dialog_content_margin_start_text"
        android:paddingEnd="@dimen/dialog_content_margin_start_text"
        android:paddingTop="@dimen/content_vertical_margin"
        android:paddingBottom="@dimen/content_vertical_margin"
        android:layout_marginBottom="@dimen/content_margin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/TextStyle"
            android:id="@+id/tvMissingCompositionsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="@string/missing_files_description"/>

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextStyle.Progress"
        android:layout_marginStart="@dimen/dialog_content_margin_start_text"
        android:layout_marginBottom="@dimen/content_vertical_margin"
        app:layout_constraintTop_toBottomOf="@+id/nsvContainer"
        app:layout_constraintStart_toStartOf="@id/nsvContainer"
        app:layout_constraintBottom_toTopOf="@id/btnPositive"
        tools:text="@string/create_progress" />

    <Button
        android:id="@+id/btnPositive"
        style="@style/ButtonBorderlessStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dialog_button_margin_horizontal"
        android:layout_marginBottom="@dimen/dialog_button_margin_vertical"
        android:layout_marginTop="@dimen/content_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="Ok"/>

    <Button
        android:id="@+id/btnNegative"
        style="@style/ButtonBorderlessStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/btnPositive"
        app:layout_constraintEnd_toStartOf="@id/btnPositive"
        app:layout_constraintBottom_toBottomOf="@id/btnPositive"
        tools:text="cancel"/>

    <Button
        android:id="@+id/btnNeutral"
        style="@style/ButtonBorderlessStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/dialog_button_margin_horizontal"
        android:maxLines="2"
        app:layout_constraintTop_toTopOf="@id/btnPositive"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/btnPositive"
        app:layout_constraintEnd_toStartOf="@+id/btnNegative"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        tools:text="long long long long long long long long long"/>

</androidx.constraintlayout.widget.ConstraintLayout>