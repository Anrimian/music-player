<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/box_inset_layout_padding"
    tools:context=".ui.MainActivity"
    tools:deviceIds="wear">

    <com.github.anrimian.musicplayer.wear.ui.utils.TimeTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15sp"
        android:paddingTop="4dp"
        android:textColor="@android:color/white"/>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/inner_frame_layout_padding"
        tools:visibility="visible"
        app:layout_boxedEdges="top">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clContentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:id="@+id/tvCompositionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lines="1"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintWidth_percent="@dimen/title_width_percent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="test test test test test test test test" />

            <TextView
                android:id="@+id/tvCompositionArtist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lines="1"
                android:textSize="11sp"
                app:layout_constraintWidth_percent="@dimen/artist_width_percent"
                app:layout_constraintTop_toBottomOf="@id/tvCompositionTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="test test test test test test test test" />

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintWidth_percent="@dimen/seekbar_width_percent"
                app:layout_constraintTop_toBottomOf="@id/tvCompositionArtist"
                app:layout_constraintBottom_toTopOf="@id/ivPlayPause"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:progress="50"/>

            <TextView
                android:id="@+id/tv_played_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="7sp"
                android:text="00:11"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="@id/seek_bar"
                app:layout_constraintTop_toBottomOf="@id/seek_bar"/>

            <TextView
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="7sp"
                android:text="11:00"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="@id/seek_bar"
                app:layout_constraintTop_toBottomOf="@id/seek_bar"/>

            <ImageView
                style="@style/ImageButtonStyle"
                android:id="@+id/ivPlayPause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:padding="4dp"
                app:layout_constraintTop_toBottomOf="@+id/seek_bar"
                app:layout_constraintBottom_toTopOf="@id/ivVolumeMinus"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:src="@drawable/anim_pause_to_play"/>

            <ImageView
                style="@style/ImageButtonStyle"
                android:id="@+id/ivPrevious"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_skip_previous"
                android:padding="8dp"
                app:layout_constraintTop_toTopOf="@id/ivPlayPause"
                app:layout_constraintBottom_toBottomOf="@id/ivPlayPause"
                app:layout_constraintEnd_toStartOf="@id/ivPlayPause"
                app:layout_constraintStart_toStartOf="parent"/>

            <ImageView
                style="@style/ImageButtonStyle"
                android:id="@+id/ivNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_skip_next"
                android:padding="8dp"
                app:layout_constraintTop_toTopOf="@id/ivPlayPause"
                app:layout_constraintBottom_toBottomOf="@id/ivPlayPause"
                app:layout_constraintStart_toEndOf="@id/ivPlayPause"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@id/ivVolumeMinus"
                app:layout_constraintEnd_toEndOf="@id/ivVolumePlus"
                app:layout_constraintBottom_toBottomOf="@id/ivVolumeMinus"
                tools:text="50%"/>

            <ImageView
                style="@style/ImageButtonStyle"
                android:id="@+id/ivVolumeMinus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_minus"
                android:padding="8dp"
                app:layout_constraintTop_toBottomOf="@id/ivPlayPause"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivVolumePlus"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"/>

            <ImageView
                style="@style/ImageButtonStyle"
                android:id="@+id/ivVolumePlus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_plus"
                android:padding="8dp"
                app:layout_constraintTop_toTopOf="@id/ivVolumeMinus"
                app:layout_constraintStart_toEndOf="@id/ivVolumeMinus"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQueue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </androidx.viewpager.widget.ViewPager>

    <LinearLayout
        android:id="@+id/llError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_boxedEdges="all"
        tools:visibility="gone">

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lines="3"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            tools:text="@string/host_app_not_found"/>

        <Button
            android:id="@+id/btnError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            tools:text="@string/locate_app"/>

    </LinearLayout>

</androidx.wear.widget.BoxInsetLayout>